    | MAIL_HOST=mail.lcbkp.gov.pk
    | MAIL_PORT=465
    | MAIL_ENCRYPTION=ssl
    | MAIL_USERNAME=training@lcbkp.gov.pk
    | MAIL_PASSWORD=your-password
    | MAIL_FROM_ADDRESS=training@lcbkp.gov.pk
